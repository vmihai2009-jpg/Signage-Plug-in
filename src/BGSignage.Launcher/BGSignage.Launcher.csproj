<Project Sdk="Microsoft.NET.Sdk">

  <!-- The small part Revit loads at start-up: the Signage panel on the Barr Gazetas tab and the Updater.
       Each click runs the newest installed "engine" (BGSignage.Engine.dll) from its own versioned folder,
       so a new release works straight away without restarting Revit. Keep this project small and stable:
       changes here only show after a Revit restart. It must not reference the engine. -->
  <PropertyGroup>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BGSignage.Launcher</AssemblyName>
    <RootNamespace>BGSignage.Launcher</RootNamespace>
    <!-- Only raise when this project changes: a newer launcher is installed for the next restart. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BGSignage.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
