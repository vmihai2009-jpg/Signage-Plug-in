<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer tool (not shipped): lays out the preset signs with real fonts on any OS and writes SVG previews,
       to check the layout engine without Revit. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
    <Compile Include="../../src/BGSignage.Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
